# Ticket 028: character workshop output, regenerable by agent-workspace/scripts/cutout.mjs.
# The proofs are contact sheets for checking cutouts on dark backgrounds and the PNGs are the
# uncompressed masters — together several megabytes that the site never serves.
public/characters/*-proof.png
agent-workspace/brand-assets/**/*.png
agent-workspace/tickets/*/proofs/

# Ticket 028: scratch output from the mobile screenshot scripts in agent-workspace/scripts.
.mobile-check/
